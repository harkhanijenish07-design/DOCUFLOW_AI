# ============================================
# DocuFlow AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ----- Application -----
APP_NAME=DocuFlow AI
APP_ENV=development
DEBUG=true
DEMO_MODE=false
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Database -----
# SQLite (default for development):
DATABASE_URL=sqlite:///./docuflow.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/docuflow
# MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/docuflow

# ----- JWT -----
JWT_SECRET_KEY=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# ----- OCR -----
TESSERACT_CMD=tesseract
# On Windows, set full path e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ----- AI / LLM -----
# OpenAI (optional):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google AI (optional):
GOOGLE_AI_API_KEY=
# HuggingFace (optional):
HF_API_TOKEN=

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@docuflow.ai

# ----- Slack -----
SLACK_WEBHOOK_URL=

# ----- Google Sheets -----
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE=docuflow.log
